# Payment Service Environment Variables

# Server Config
PORT=3002
NODE_ENV=development

# MongoDB Config
MONGO_URI=mongodb://mongo:27017/ride_share_db
MONGO_DB_NAME=ride_share_db

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Service URLs
BOOKING_SERVICE_URL=http://booking-service:3001
NOTIFICATION_SERVICE_URL=http://notification-service:5002

# Commission Settings
PLATFORM_COMMISSION_PERCENTAGE=15
TAX_PERCENTAGE=5
