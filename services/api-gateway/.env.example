# API Gateway Environment Variables

# Server Config
PORT=3000
NODE_ENV=development

# Service URLs (internal microservices)
USER_SERVICE_URL=http://user-service:5000
DRIVER_SERVICE_URL=http://driver-service:5001
BOOKING_SERVICE_URL=http://booking-service:3001
PAYMENT_SERVICE_URL=http://payment-service:3002
NOTIFICATION_SERVICE_URL=http://notification-service:5002

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

